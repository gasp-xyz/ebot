# Copy to .env and replace every REPLACE_WITH value before running the bot.
# No production deployment addresses or service credentials are supplied.

# Server and optional tunnel
PORT=3000
LOCALTUNNEL_SUBDOMAIN=

# RPC endpoints (all must target the same chain as the contracts below)
WS_RPC_URL=ws://localhost:8545
HTTP_RPC_URL=http://localhost:8545
INFURA_FS_URL=REPLACE_WITH_FRONT_SWAP_HTTP_RPC_URL
INFURA_BS_URL=REPLACE_WITH_BACK_SWAP_HTTP_RPC_URL

# Deployed contracts and route assets
TRADE_CONTRACT_ADDRESS=REPLACE_WITH_YOUR_DEPLOYED_TRADE_CONTRACT_ADDRESS
UNISWAP_ROUTER_ADDRESS=REPLACE_WITH_UNISWAP_ROUTER_ADDRESS
SUSHISWAP_ROUTER_ADDRESS=REPLACE_WITH_SUSHISWAP_ROUTER_ADDRESS
BALANCER_ROUTER_ADDRESS=REPLACE_WITH_BALANCER_ROUTER_ADDRESS
UNISWAP_FACTORY_ADDRESS=REPLACE_WITH_UNISWAP_FACTORY_ADDRESS
SUSHISWAP_FACTORY_ADDRESS=REPLACE_WITH_SUSHISWAP_FACTORY_ADDRESS
WETH_ADDRESS=REPLACE_WITH_WETH_ADDRESS
DAI_ADDRESS=REPLACE_WITH_DAI_ADDRESS
USDC_ADDRESS=REPLACE_WITH_USDC_ADDRESS
USDT_ADDRESS=REPLACE_WITH_USDT_ADDRESS
WBTC_ADDRESS=REPLACE_WITH_WBTC_ADDRESS

# Deployment-only inputs for the Solidity constructors; see README.md.
# JavaScript does not read these additional deployment parameters.
CHI_ADDRESS=REPLACE_WITH_CHI_ADDRESS
AAVE_LENDING_POOL_ADDRESS=REPLACE_WITH_AAVE_LENDING_POOL_ADDRESS
AAVE_CORE_ADDRESS=REPLACE_WITH_AAVE_CORE_ADDRESS
AAVE_NATIVE_ASSET_ADDRESS=REPLACE_WITH_AAVE_NATIVE_ASSET_ADDRESS

# Wallets: generated locally; never commit the keystores or passwords.
FS_WALLET_PATH=wallets/wallet.json
BS_WALLET_PATH=wallets/walletbs.json
FS_WALLET_PASSWORD=REPLACE_WITH_FRONT_SWAP_WALLET_PASSWORD
BS_WALLET_PASSWORD=REPLACE_WITH_BACK_SWAP_WALLET_PASSWORD

# Gas-price provider (must use the response shape documented in README.md)
ETH_GAS_STATION_URL=REPLACE_WITH_GAS_PRICE_HTTP_API_URL
ETH_GAS_STATION_API_KEY=
GAS_POLL_INTERVAL_MS=60000

# Comma-separated token-list HTTP(S) URLs; each returns {"tokens":[{"address":...}]}.
TOKEN_LIST_URLS=REPLACE_WITH_TOKEN_LIST_HTTP_URL

# Optional maintenance script inputs; populate only when intentionally using them.
TO_ADDRESS=REPLACE_WITH_WITHDRAWAL_RECIPIENT_ADDRESS
TOKEN=REPLACE_WITH_TOKEN_ADDRESS
TOKEN_IN=REPLACE_WITH_INPUT_TOKEN_ADDRESS
TOKEN_OUT=REPLACE_WITH_OUTPUT_TOKEN_ADDRESS
